# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
# ⚠️ 百炼 API Key 按【地域】绑定：用北京 Key 调新加坡 endpoint 会返回
#    401 Incorrect API key provided（是地域不匹配，不是 Key 失效）。
DASHSCOPE_API_KEY=your-dashscope-api-key

# 端点。现有域名仍可正常使用；百炼建议迁到业务空间专属域名（注意把 {WorkspaceId} 换成真实值）：
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 模型（2026-09-20 迁移：deepseek-v3.2 于 2026-10-10 下架）---
# 代码默认值见 config/llm_config.py；此处列出便于按需覆盖。
# architect / data_analyst / wizard / critic / writer 用 deepseek-v4.1-flash
# scout（搜索与证据抽取）用 qwen3.7-flash
# 仅被旧功能路径使用（ENABLE_LEGACY_FEATURES / ENABLE_TEXT2SQL 默认关闭）：
OPENAI_MODEL=qwen3.7-flash

# 长期记忆抽取用的模型（service/memory_service.py）
DASHSCOPE_MODEL=qwen3.7-flash

# --- Embedding ---
# qwen3.7-text-embedding-flash：默认 1024 维（亦支持 256/512/768），上下文 128K。
# ⚠️ EMBEDDING_DIMENSIONS 必须与 MILVUS_VECTOR_DIM 一致；改动等于改集合 schema，需重建索引。
# ⚠️ 换 embedding 模型后【旧向量不可复用】，既有知识库必须重建索引。
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
MILVUS_VECTOR_DIM=1024

# --- 全文可见性与证据额度（影响 claim 必要条件能否满足）---
# 学术来源抓取全文的字符上限（单篇）。实测 arXiv html 正文可达 6 万+字符。
FULLTEXT_MAX_CHARS=60000
# 每轮检索最多对前 N 条学术来源抓全文（控制延迟与抓取成本）。
FULLTEXT_PER_QUERY_LIMIT=3
# 送入抽取模型的证据额度：**总预算驱动条数**，单篇不超过 EVIDENCE_EXCERPT_CHARS。
# 实测：单篇从 8000 提到 12000 字符后，claim 的必要条件（task/dataset/model/metric…）
# 由「大量缺失」变为**基本填满**（8/8），这是 contract_complete 能否成立的关键。
EVIDENCE_TOTAL_CHARS=48000
EVIDENCE_EXCERPT_CHARS=12000
# 检索域白名单（Bocha include 参数）。不限定时实测 10 条里 0 条学术来源。
ENABLE_ACADEMIC_DOMAIN_FILTER=true
# ACADEMIC_INCLUDE_DOMAINS 留空则用代码内置的学术域白名单
ENABLE_FULLTEXT_FETCH=true

# --- 思考模式（PR1 可信度收口：默认**关闭**）---
# 默认关闭不是结论「thinking 更差」，而是固定已测能跑完的非 thinking 配置作为运行基线：
# 当前优先修错误判定逻辑，增 token 不能替代修判定。thinking 需逐 Agent、
# 固定材料与计划做实验，证明错误支持下降且成本可接受后才默认开启。
# 思考 token 按【输出价】计费且【占用 max_tokens】，开启前先确认输出不会被截断。
LLM_ENABLE_THINKING=false
# 仅 deepseek-v4* 生效（qwen3.7-flash 不支持该参数），可选 low / high / max
LLM_REASONING_EFFORT=high

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 搜索 API ====================
# 博查搜索 API（必填）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=your-bocha-api-key

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
# 申请地址: https://www.juhe.cn/docs/api/id/21
JUHE_STOCK_API_KEY=your-juhe-stock-api-key

# ==================== 招投标 API ====================
# 阿里云市场 - 招投标信息 API（可选）
# 申请地址: https://market.aliyun.com/detail/cmapi00063550
BID_APP_KEY=your-bid-app-key
BID_APP_SECRET=your-bid-app-secret
BID_APP_CODE=your-bid-app-code

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== PostgreSQL ====================
# LitTrace 使用独立容器 littrace-pg（宿主 5433），避免与占用 5432 的其他项目冲突。
# 见 deploy/.env.example 与 环境实测结论备忘.md 第 2.3 节。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=littrace
# 必须自行设置，不要提交真实值
POSTGRES_PASSWORD=
POSTGRES_DB=littrace_dev

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== JWT 认证 ====================
# 建议生成一个随机密钥，生产环境务必修改
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 其他配置 ====================
MEM_LIMIT=8073741824
TIMEZONE=Asia/Shanghai

# ==================== LitTrace 功能开关 ====================
# 缺配置即拒绝启动（fail-closed），不要指望静默默认值。取值只接受 true/false/1/0。
# 见 backend/app/core/runtime_settings.py::validate_startup

# 方向档案（多方向选题：agent_memory / rag_context / llm_evaluation）
ENABLE_DIRECTION_PROFILES=true

# 联网检索。为 true 时 BOCHA_API_KEY 变为【必需】，缺失即拒绝启动。
ENABLE_WEB_SEARCH=true

# 文档解析。为 true 时 DOCMIND_ACCESS_KEY_ID / _SECRET 变为必需。
ENABLE_DOCMIND=false

# 旧功能（资讯采集 / 招投标 / RAGFlow 等）。为 true 时 API_KEY 变为必需。
# 默认关闭：启动时不初始化旧采集、不注册任务、不发旧外部 API 请求（对应 C13-I）。
ENABLE_LEGACY_FEATURES=false

# 旧资讯定时采集调度器（依赖 ENABLE_LEGACY_FEATURES）
ENABLE_NEWS_SCHEDULER=false

# Text2SQL 数据问答（原项目硬编码「智慧交通」并配无关 NEV mock 数据）
ENABLE_TEXT2SQL=false

# 代码执行。⚠️ 本包中仍是【进程内 exec】，不是沙箱；不要对不可信输入开启。
ENABLE_CODE_EXECUTION=false

# 图表数量上限与质量阈值（质量阈值影响 A6 的 passed 判定）
MAX_CHARTS=2
QUALITY_THRESHOLD=6

# 跨域来源。必须是 JSON 数组，且不允许通配符 "*"（含 "*" 即拒绝启动）。
# runtime_settings.py::cors_origins 只接受 scheme + host + 可选端口。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==================== 旧功能 API（仅 ENABLE_LEGACY_FEATURES=true 时需要）====================
# 聚合数据 - 股票行情 API（可选）
JUHE_STOCK_API_KEY=

# 阿里云市场 - 招投标信息 API（可选）
BID_APP_KEY=
BID_APP_SECRET=
BID_APP_CODE=

