# 从本模板私有复制为应用根目录的 `.env`；切勿提交真实值。
# 与 backend/.env.example 的关系：本文件是打包清单附带的【可运行最小集】，
# backend/.env.example 是项目完整样板（含 Milvus / Redis / LLM 等）。两者都要保持一致。

# --- PostgreSQL ---
# LitTrace 使用独立容器 littrace-pg（宿主 5433），与占用 5432 的其他项目隔离。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=littrace
POSTGRES_DB=littrace_dev
POSTGRES_PASSWORD=

# --- 必需密钥 ---
# JWT_SECRET_KEY 必须 >=32 字符，否则启动即拒绝（fail-closed）。
JWT_SECRET_KEY=
DASHSCOPE_API_KEY=

# --- 模型（2026-09-20 迁移；deepseek-v3.2 于 2026-10-10 下架）---
# 默认值在代码里（config/llm_config.py），此处仅列可覆盖项。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-flash
OPENAI_MODEL=qwen3.7-flash
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
MILVUS_VECTOR_DIM=1024
# 思考模式（PR1 起默认**关闭**：固定能跑完的非 thinking 配置作为基线；
# 思考 token 按输出价计费且占用 max_tokens，开启前先确认输出不会被截断）
LLM_ENABLE_THINKING=false
# 仅 deepseek-v4* 生效，可选 low / high / max
LLM_REASONING_EFFORT=high

# --- 可选密钥 ---
# BOCHA_API_KEY 在 ENABLE_WEB_SEARCH=true（默认）时必需。
BOCHA_API_KEY=
DOCMIND_ACCESS_KEY_ID=
DOCMIND_ACCESS_KEY_SECRET=
API_KEY=
SERPER_API_KEY=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- 网络与跨域 ---
# 必须是 JSON 数组，且不允许通配符 "*"；只允许 scheme+host+可选端口。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- 功能开关（10 项）---
ENABLE_LEGACY_FEATURES=false
ENABLE_NEWS_SCHEDULER=false
ENABLE_TEXT2SQL=false
ENABLE_DIRECTION_PROFILES=true
ENABLE_WEB_SEARCH=true
ENABLE_DOCMIND=false
ENABLE_CODE_EXECUTION=false
MAX_CHARTS=2
QUALITY_THRESHOLD=6
# 本包中代码执行仍在【进程内】。不要把不可信 exec 暴露出去。
